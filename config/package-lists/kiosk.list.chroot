# Packages installed into the kiosk OS image.

# X server + minimal window manager (no desktop environment)
xserver-xorg
xserver-xorg-legacy
xserver-xorg-video-all
xserver-xorg-input-all
xinit
x11-xserver-utils
openbox

# Mesa software rendering fallback (black-screen fix in VMs without 3D)
libgl1-mesa-dri

# The browser
chromium

# Audio: PipeWire stack for speaker + microphone
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
alsa-utils

# Boot splash / welcome screen
plymouth
plymouth-themes
feh

# Global hotkeys for power off / reboot
xbindkeys

# Quality-of-life
unclutter
fonts-liberation
fonts-noto-color-emoji
ca-certificates

# Networking (so YouTube can reach the internet)
network-manager

# Firmware for common wifi/audio/gpu hardware
firmware-linux
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek

# Base utilities
sudo
